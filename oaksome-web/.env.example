# ──────────────────────────────────────────────────────────
# Build-time — baked into the JS bundle (required at docker build)
# Pass these as --build-arg in Dockerfile / build.args in docker-compose
# ──────────────────────────────────────────────────────────
# REQUIRED. Used to allowlist Odoo in next/image remotePatterns and in CSP
# connect-src. Browser-visible. Set to the Odoo URL the browser will reach
# directly (CDN or public Odoo host).
NEXT_PUBLIC_ODOO_URL=https://cdn.oaksome.com
NEXT_PUBLIC_SITE_URL=https://oaksome.com
NEXT_PUBLIC_GTM_ID=
# Odoo livechat channel ID (visible in Odoo Live Chat > Channels)
NEXT_PUBLIC_LIVECHAT_CHANNEL=2
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_PINTEREST_TAG_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Axeptio CMP client ID (Axeptio project ID, e.g. "oaksome-prod").
# Validated against ^[a-zA-Z0-9-]+$. Layout skips rendering the loader when unset.
NEXT_PUBLIC_AXEPTIO_CLIENT_ID=

# ──────────────────────────────────────────────────────────
# Runtime — server-side only, never exposed to the browser
# Set in .env.production on the host (loaded via env_file in docker-compose)
# ──────────────────────────────────────────────────────────
META_CAPI_ACCESS_TOKEN=
META_CAPI_PIXEL_ID=
GOOGLE_ADS_CONVERSION_ID=

# REQUIRED server-side. Used by Next.js rewrites (/shop, /cart, /wishlist
# proxies). If unset, those proxy routes silently disable.
# Docker internal: http://192.168.30.39:8069 in prod
ODOO_URL=http://localhost:8069

# HMAC secret for invite tokens (LandingGate). REQUIRED in production: must be
# >= 32 chars and not a placeholder, or the app fails to boot.
# Generate with: openssl rand -base64 48
INVITE_TOKEN_SECRET=

# Shared secret guarding the on-demand revalidation endpoint (/api/revalidate).
# Requests without a matching secret are rejected. Generate with:
# openssl rand -base64 48
REVALIDATE_SECRET=

# Google OAuth — create credentials at console.cloud.google.com with the Oaksome prod account
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
