# Build-time — baked into client bundle during docker build.
# These must be present at `docker compose build` time; runtime swaps do not
# take effect because Next.js inlines them into the JS bundle.
NEXT_PUBLIC_ODOO_URL=https://cdn.oaksome.com
NEXT_PUBLIC_SITE_URL=https://oaksome.com
NEXT_PUBLIC_GTM_ID=
# Odoo livechat channel ID
NEXT_PUBLIC_LIVECHAT_CHANNEL=2
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_PINTEREST_TAG_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Axeptio CMP project ID (e.g. "oaksome-prod"). Validated against ^[a-zA-Z0-9-]+$
# at runtime. Layout skips rendering the loader if empty/invalid — leaving this
# blank silently disables the consent banner (GDPR compliance gap in the EU).
NEXT_PUBLIC_AXEPTIO_CLIENT_ID=

# Runtime — server-side only, never exposed to the browser.
META_CAPI_ACCESS_TOKEN=
META_CAPI_PIXEL_ID=
GOOGLE_ADS_CONVERSION_ID=
# Internal Odoo URL — server-side only (Docker network IP in prod).
ODOO_URL=http://192.168.30.39:8069

# LandingGate invite token secret — REQUIRED before public launch.
# Must be >= 32 chars and not a placeholder, or the app fails to boot.
# Generate with: openssl rand -base64 48
# If unset, the middleware returns 503 on every gated request rather than
# silently allowing all visitors through.
INVITE_TOKEN_SECRET=

# Shared secret guarding the on-demand revalidation endpoint (/api/revalidate).
# Requests without a matching secret are rejected. Generate with:
# openssl rand -base64 48
REVALIDATE_SECRET=

# Comma-separated list of valid invite codes. Visitors must submit one of
# these on the landing page to receive a signed cookie that unlocks the site.
# Example: INVITE_CODES=PRESS-2026,VIP-TRADE-SHOW,OAKSOME-BETA
INVITE_CODES=
